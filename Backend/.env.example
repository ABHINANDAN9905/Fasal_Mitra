# Backend Server Port
PORT=5000

# Government of India Data.gov.in API Configuration
# Get your free API key at: https://data.gov.in/
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Agmarknet Daily Mandi Prices Resource ID on data.gov.in
# Default resource ID for Current Daily Price of Various Commodities from Various Mandis:
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Backward-compatible environment aliases
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
